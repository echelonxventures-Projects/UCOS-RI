#!/bin/sh
# UCOS-RI entry point (CIC-001-001 §1.1 rule 2). It only drives an OCI runtime with the Compose spec;
# every toolchain runs inside digest-pinned containers. Override the runtime with UCOS_OCI=podman|nerdctl.
set -eu
cd "$(dirname "$0")"
OCI="${UCOS_OCI:-docker}"
UCOS_UID="$(id -u)"; UCOS_GID="$(id -g)"; export UCOS_UID UCOS_GID
compose() { "$OCI" compose "$@"; }
tools() { compose --profile tools run --rm --no-deps -T tools "$@"; }
modules() { for m in domains/*/ucos-module.yaml platform/*/*/ucos-module.yaml kernel/ucos-module.yaml services/*/*/ucos-module.yaml; do [ -f "$m" ] && dirname "$m"; done; }
runners() { for m in platform/*/*/ucos-module.yaml; do grep -q "^conformanceRunner: true" "$m" && dirname "$m"; done; }
img() { echo "ucos-$(echo "$1" | cut -d/ -f2)-$(basename "$1"):local"; }

ctx_conformance() {
  n="${1:-20000}"; w=.work/ctxrt; mkdir -p "$w"
  compose --profile tools build tools
  for r in $(runners); do "$OCI" build -q --target runtime -t "$(img "$r")" -f "$r/Containerfile" "$r" >/dev/null; done
  tools python tools/ctxrt_suite.py golden-input > "$w/golden.in"
  tools python tools/ctxrt_suite.py bench-input > "$w/bench.in"
  outs=""; benches=""; hashes=""
  for r in $(runners); do
    b="$(basename "$r")"
    "$OCI" run --rm -i "$(img "$r")" < "$w/golden.in" > "$w/golden.$b.out"; outs="$outs $w/golden.$b.out"
    "$OCI" run --rm -i "$(img "$r")" < "$w/bench.in" > "$w/bench.$b.out"; benches="$benches $w/bench.$b.out"
    echo "== differential: $n generated cases through $b"
    tools python tools/ctxrt_suite.py gen "$n" | "$OCI" run --rm -i "$(img "$r")" \
      | tools python tools/ctxrt_suite.py digest > "$w/gen.$b.hashes"; hashes="$hashes $w/gen.$b.hashes"
  done
  # shellcheck disable=SC2086
  tools python tools/ctxrt_suite.py golden-check $outs
  # shellcheck disable=SC2086
  tools python tools/ctxrt_suite.py compare "$n" $hashes
  # shellcheck disable=SC2086
  tools python tools/ctxrt_suite.py bench-check $benches
}

usage() {
  cat <<USAGE
usage: ./ucos <command>
  verify        corpus lock + corpus validation + contract drift + contract lint + module manifests
  gen           regenerate contracts from the vendored corpus
  build         build tool and module images
  test          run every module's unit/architecture tests (Containerfile 'test' stage)
  up | down     start / stop and wipe the ucos-lite profile
  conformance   start ucos-lite and run the black-box conformance suites
  ctx-conformance [N]   context-runtime suites: golden + fallback order, N-case differential across
                        every runtime implementation (default 20000; certification: 1000000), benchmark
  ci            verify, test, conformance, down
  corpus-lock <tag> <commit>   rewrite corpus.lock after vendoring a new corpus release
USAGE
}

cmd="${1:-}"; [ $# -gt 0 ] && shift
case "$cmd" in
  verify)
    compose --profile tools build tools
    tools sh -c 'python tools/corpus_lock.py check &&
      (cd corpus && python tools/validate.py) &&
      python tools/gen_contracts.py --check && python tools/lint_contracts.py && python tools/check_modules.py' ;;
  gen) compose --profile tools build tools && tools python tools/gen_contracts.py ;;
  build) compose --profile tools build ;;
  test)
    for m in $(modules); do
      ctx="$m"; grep -q "^buildContext: \." "$m/ucos-module.yaml" && ctx=.
      echo "== test $m"; "$OCI" build --target test -f "$m/Containerfile" "$ctx"
    done ;;
  up) compose --profile tools build && compose up -d echo metadata eventing ;;
  down) compose --profile test down -v --remove-orphans ;;
  conformance)
    # The full black-box suite runs once per event-platform-service implementation, each swapped into a fresh
    # ucos-lite with no other change (CR-030-001-05).
    compose --profile tools build
    mkdir -p .work && tools python tools/pack_bundle.py corpus/packs/ucos.std > .work/ucos.std.publish.json
    for impl in ${UCOS_EVENTING_IMPLS:-go typescript}; do
      echo "== conformance with event-platform-service implementation: $impl"
      compose --profile test down -v --remove-orphans >/dev/null 2>&1 || true
      UCOS_EVENTING_IMPL=$impl compose build eventing
      UCOS_EVENTING_IMPL=$impl compose up -d echo metadata eventing
      UCOS_EVENTING_IMPL=$impl compose --profile test run --rm conformance || exit 1
    done ;;
  ci)
    "$0" verify && "$0" test && "$0" ctx-conformance && status=0 && "$0" conformance || status=$?
    [ "${status:-1}" -ne 0 ] && compose logs echo migrate 2>/dev/null | tail -100 || true
    "$0" down; exit "${status:-1}" ;;
  ctx-conformance) ctx_conformance "$@" ;;
  corpus-lock) tools python tools/corpus_lock.py write "$@" ;;
  *) usage; [ -z "$cmd" ] || exit 2 ;;
esac
