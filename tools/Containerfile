# ucos-tools: the only toolchain the repository needs besides per-module build images.
FROM python@sha256:02108f5d322dd89f1c9e552442c25acb0543dfdbc455693a5599624f20d9155d
ENV PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
COPY tools/requirements.txt /opt/ucos/requirements.txt
RUN pip install -r /opt/ucos/requirements.txt
WORKDIR /work
