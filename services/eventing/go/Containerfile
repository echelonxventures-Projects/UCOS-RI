# event-platform-service (Go) — context = repository root (.dockerignore).
FROM golang@sha256:1ae0735f00daffa3aaf1363a5184c0d2dc55c78e3db4ec70241cdac97bf84b59 AS build
ENV CGO_ENABLED=0 GOFLAGS=-mod=readonly
COPY platform/context-runtime/go /src/platform/context-runtime/go
COPY platform/authn/go /src/platform/authn/go
COPY services/eventing/go/go.mod services/eventing/go/go.sum /src/services/eventing/go/
WORKDIR /src/services/eventing/go
RUN go mod download && go mod verify
COPY services/eventing/go /src/services/eventing/go
RUN go build -trimpath -ldflags="-s -w" -o /out/event-platform-service ./cmd/event-platform-service

FROM build AS test
RUN go vet ./... && go test -count=1 ./...

FROM gcr.io/distroless/static-debian12@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab AS runtime
COPY --from=build /out/event-platform-service /event-platform-service
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/event-platform-service"]
