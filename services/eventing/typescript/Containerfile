# event-platform-service (TypeScript, Node 24 type stripping) — context = repository root (.dockerignore).
FROM node@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS build
WORKDIR /repo/services/eventing/typescript
COPY services/eventing/typescript/package.json services/eventing/typescript/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund
COPY platform/context-runtime/typescript/src /repo/platform/context-runtime/typescript/src
COPY services/eventing/typescript/src ./src
COPY services/eventing/typescript/test ./test

FROM build AS test
RUN node --test "test/*.test.ts"

FROM node@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS runtime
COPY --from=build /repo /repo
WORKDIR /repo/services/eventing/typescript
USER node
EXPOSE 8080
ENTRYPOINT ["node", "src/server.ts"]
