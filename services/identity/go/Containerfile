# identity-service (Go) — context = repository root (.dockerignore).
FROM golang@sha256:1ae0735f00daffa3aaf1363a5184c0d2dc55c78e3db4ec70241cdac97bf84b59 AS build
ENV CGO_ENABLED=0 GOFLAGS=-mod=readonly
COPY platform/authn/go /src/platform/authn/go
COPY platform/pdp/go /src/platform/pdp/go
COPY services/identity/go/go.mod services/identity/go/go.sum /src/services/identity/go/
WORKDIR /src/services/identity/go
RUN go mod download && go mod verify
COPY services/identity/go /src/services/identity/go
RUN go build -trimpath -ldflags="-s -w" -o /out/identity-service ./cmd/identity-service

FROM build AS test
RUN go vet ./... && go test -count=1 ./... && cd /src/platform/authn/go && go test -count=1 ./...

FROM gcr.io/distroless/static-debian12@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab AS runtime
COPY --from=build /out/identity-service /identity-service
USER nonroot:nonroot
EXPOSE 8080 8081
ENTRYPOINT ["/identity-service"]
