{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-ucos-id": "urn:ucos:ucos.kernel:schema:problem@1.0.0",
  "title": "ProblemDetails",
  "description": "RFC 9457 Problem Details with UCOS extensions (CIC-005-001 \u00a77).",
  "type": "object",
  "required": [
    "type",
    "title",
    "status",
    "code",
    "correlationId"
  ],
  "properties": {
    "type": {
      "type": "string",
      "format": "uri"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
    },
    "code": {
      "type": "string",
      "pattern": "^E-[A-Z0-9]+(-[A-Z0-9]+)+$"
    },
    "detail": {
      "type": "string"
    },
    "instance": {
      "type": "string"
    },
    "correlationId": {
      "$ref": "ulid.schema.json"
    },
    "retryable": {
      "type": "boolean"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "pointer": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "params": {
            "type": "object"
          }
        }
      }
    }
  }
}
