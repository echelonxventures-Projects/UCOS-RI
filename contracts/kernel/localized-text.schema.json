{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-ucos-id": "urn:ucos:ucos.kernel:schema:localized-text@1.0.0",
  "title": "LocalizedText",
  "description": "Map of BCP 47 language tag to text.",
  "type": "object",
  "minProperties": 1,
  "propertyNames": {
    "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
  },
  "additionalProperties": {
    "type": "string"
  }
}
