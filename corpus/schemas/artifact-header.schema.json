{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ucos:ucos.std:schema:artifact-header@1.0.0",
  "title": "UCOS CIC Artifact Header",
  "type": "object",
  "required": ["id", "title", "version", "status", "authority", "corpus", "dependencies", "traces", "certification", "validation"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^(CIC-[0-9]{3}-[0-9]{3}|DOM-[A-Z]{3,5})$"},
    "title": {"type": "string", "minLength": 3},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"},
    "status": {"enum": ["draft", "normative", "informative", "deprecated", "superseded"]},
    "authority": {"type": "string", "minLength": 3},
    "corpus": {"type": "string", "pattern": "^CORPUS-[0-9]{3}$"},
    "dependencies": {"type": "array", "items": {"type": "string", "pattern": "^CIC-[0-9]{3}-[0-9]{3}$"}, "uniqueItems": true},
    "traces": {"type": "array", "items": {"type": "string", "pattern": "^(PRIN-[0-9]{3}|DOM-[A-Z]{3,5}|CIC-[0-9]{3}-[0-9]{3})$"}, "uniqueItems": true},
    "certification": {"type": "array", "items": {"type": "string", "pattern": "^CR-([0-9]{3}-[0-9]{3}|[A-Z]{3,5})-[0-9]{2}$"}, "uniqueItems": true},
    "validation": {"type": "array", "items": {"type": "string", "pattern": "^VR-([0-9]{3}-[0-9]{3}|[A-Z]{3,5})-[0-9]{2}$"}, "uniqueItems": true},
    "supersededBy": {"type": "string", "pattern": "^CIC-[0-9]{3}-[0-9]{3}$"}
  }
}
