{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ucos:ucos.std:schema:domain-spec@1.0.0",
  "title": "UCOS Domain Specification",
  "type": "object",
  "required": ["header", "purpose", "scope", "responsibilities", "principles", "boundaries", "ownership", "capabilities", "services", "aggregates", "entities", "valueObjects", "commands", "queries", "apis", "events", "stateMachines", "rules", "policies", "decisions", "security", "governance", "runtimeBehavior", "persistenceModel", "extensionModel", "certificationCriteria"],
  "properties": {
    "header": {"$ref": "artifact-header.schema.json"},
    "purpose": {"type": "string", "minLength": 20},
    "scope": {"type": "object", "required": ["includes", "excludes"]},
    "responsibilities": {"type": "array", "minItems": 1},
    "principles": {"type": "array", "minItems": 1},
    "boundaries": {"type": "object", "required": ["upstream", "downstream"]},
    "ownership": {"type": "object", "required": ["boundedContext", "owningRole", "service"]},
    "capabilities": {"type": "array", "minItems": 1},
    "services": {"type": "array", "minItems": 1},
    "aggregates": {"type": "array", "minItems": 1},
    "entities": {"type": "array"},
    "valueObjects": {"type": "array", "minItems": 1},
    "commands": {"type": "array", "minItems": 1},
    "queries": {"type": "array", "minItems": 1},
    "apis": {"type": "array", "minItems": 1},
    "events": {"type": "array", "minItems": 1},
    "stateMachines": {"type": "array", "minItems": 1},
    "rules": {"type": "array", "minItems": 1},
    "policies": {"type": "array", "minItems": 1},
    "decisions": {"type": "array", "minItems": 1},
    "security": {"type": "object", "required": ["permissions", "dataClassification"]},
    "governance": {"type": "object", "required": ["changeControl"]},
    "runtimeBehavior": {"type": "object", "required": ["consistency", "slo"]},
    "persistenceModel": {"type": "object", "required": ["store", "tables"]},
    "extensionModel": {"type": "object", "required": ["extensionPoints"]},
    "certificationCriteria": {"type": "array", "minItems": 1}
  }
}
