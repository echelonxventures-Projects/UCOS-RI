{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ucos:ucos.std:schema:resolution-config@1.0.0",
  "title": "ResolutionConfig (CIC-011-001 §3)",
  "type": "object",
  "required": ["conflictStrategy", "cardinality", "relaxationAllowed"],
  "additionalProperties": false,
  "properties": {
    "dimensionPrecedence": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$"}, "uniqueItems": true},
    "conflictStrategy": {"type": "string", "pattern": "^(error|most-recent|lowest-value|highest-value|merge|all|policy:urn:ucos:.+)$"},
    "fallbackChains": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$"}, "uniqueItems": true},
    "cardinality": {"enum": ["one", "many"]},
    "relaxationAllowed": {"type": "boolean"},
    "maxFallbackSteps": {"type": "integer", "minimum": 1, "maximum": 64},
    "hitPolicy": {"enum": ["first", "priority", "collect", "collect-sum", "unique", "any"]},
    "combine": {"enum": ["deny-overrides", "permit-overrides"]}
  }
}
