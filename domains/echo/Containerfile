# echo-service — container-only build (CIC-001-001 §1.1); context = repository root (.dockerignore).
FROM golang@sha256:1ae0735f00daffa3aaf1363a5184c0d2dc55c78e3db4ec70241cdac97bf84b59 AS build
ENV CGO_ENABLED=0 GOFLAGS=-mod=readonly
COPY platform/authn/go /src/platform/authn/go
COPY domains/echo/go.mod domains/echo/go.sum /src/domains/echo/
WORKDIR /src/domains/echo
RUN go mod download && go mod verify
COPY domains/echo /src/domains/echo
RUN go build -trimpath -ldflags="-s -w" -o /out/echo-service ./cmd/echo-service

FROM build AS test
RUN go vet ./... && go test -count=1 ./...

FROM gcr.io/distroless/static-debian12@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab AS runtime
COPY --from=build /out/echo-service /echo-service
USER nonroot:nonroot
EXPOSE 8080 8081
ENTRYPOINT ["/echo-service"]
